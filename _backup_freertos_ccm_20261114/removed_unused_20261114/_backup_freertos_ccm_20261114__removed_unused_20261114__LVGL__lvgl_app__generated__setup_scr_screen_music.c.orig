#include "lvgl.h"
#include <stdio.h>
#include "gui_guider.h"
#include "events_init.h"
#include "widgets_init.h"
#include "custom.h"

void setup_scr_screen_music(lv_ui *ui)
{
    // Write codes screen_music
    ui->screen_music = lv_obj_create(NULL);
    lv_obj_set_size(ui->screen_music, 240, 280);
    lv_obj_set_scrollbar_mode(ui->screen_music, LV_SCROLLBAR_MODE_OFF);

    // Write style for screen_music, Part: LV_PART_MAIN, State: LV_STATE_DEFAULT.
    lv_obj_set_style_bg_opa(ui->screen_music, 0, LV_PART_MAIN | LV_STATE_DEFAULT);
    lv_obj_set_style_bg_image_src(ui->screen_music, PIC_BACK_240280, LV_PART_MAIN | LV_STATE_DEFAULT);
    lv_obj_set_style_bg_image_opa(ui->screen_music, 255, LV_PART_MAIN | LV_STATE_DEFAULT);
    lv_obj_set_style_bg_image_recolor_opa(ui->screen_music, 0, LV_PART_MAIN | LV_STATE_DEFAULT);

    // Write codes screen_music_bar_music
    ui->screen_music_bar_music = lv_bar_create(ui->screen_music);
    lv_obj_set_pos(ui->screen_music_bar_music, 5, 200);
    lv_obj_set_size(ui->screen_music_bar_music, 120, 12);
    lv_obj_set_style_anim_duration(ui->screen_music_bar_music, 1000, 0);
    lv_bar_set_mode(ui->screen_music_bar_music, LV_BAR_MODE_NORMAL);
    lv_bar_set_range(ui->screen_music_bar_music, 0, 100);
    lv_bar_set_value(ui->screen_music_bar_music, 6, LV_ANIM_OFF);

    // Write style for screen_music_bar_music, Part: LV_PART_MAIN, State: LV_STATE_DEFAULT.
    lv_obj_set_style_bg_opa(ui->screen_music_bar_music, 60, LV_PART_MAIN | LV_STATE_DEFAULT);
    lv_obj_set_style_bg_color(ui->screen_music_bar_music, lv_color_hex(0x2195f6), LV_PART_MAIN | LV_STATE_DEFAULT);
    lv_obj_set_style_bg_grad_dir(ui->screen_music_bar_music, LV_GRAD_DIR_NONE, LV_PART_MAIN | LV_STATE_DEFAULT);
    lv_obj_set_style_radius(ui->screen_music_bar_music, 10, LV_PART_MAIN | LV_STATE_DEFAULT);
    lv_obj_set_style_shadow_width(ui->screen_music_bar_music, 0, LV_PART_MAIN | LV_STATE_DEFAULT);

    // Write style for screen_music_bar_music, Part: LV_PART_INDICATOR, State: LV_STATE_DEFAULT.
    lv_obj_set_style_bg_opa(ui->screen_music_bar_music, 255, LV_PART_INDICATOR | LV_STATE_DEFAULT);
    lv_obj_set_style_bg_color(ui->screen_music_bar_music, lv_color_hex(0x2195f6), LV_PART_INDICATOR | LV_STATE_DEFAULT);
    lv_obj_set_style_bg_grad_dir(ui->screen_music_bar_music, LV_GRAD_DIR_NONE, LV_PART_INDICATOR | LV_STATE_DEFAULT);
    lv_obj_set_style_radius(ui->screen_music_bar_music, 10, LV_PART_INDICATOR | LV_STATE_DEFAULT);

    // Write codes screen_music_label_music_time
    ui->screen_music_label_music_time = lv_label_create(ui->screen_music);
    lv_obj_set_pos(ui->screen_music_label_music_time, 140, 200);
    lv_obj_set_size(ui->screen_music_label_music_time, 100, 20);
    lv_label_set_text(ui->screen_music_label_music_time, "00:18/4:49");
    lv_label_set_long_mode(ui->screen_music_label_music_time, LV_LABEL_LONG_WRAP);

    // Write style for screen_music_label_music_time, Part: LV_PART_MAIN, State: LV_STATE_DEFAULT.
    lv_obj_set_style_border_width(ui->screen_music_label_music_time, 0, LV_PART_MAIN | LV_STATE_DEFAULT);
    lv_obj_set_style_radius(ui->screen_music_label_music_time, 0, LV_PART_MAIN | LV_STATE_DEFAULT);
    lv_obj_set_style_text_color(ui->screen_music_label_music_time, lv_color_hex(0x0D3055), LV_PART_MAIN | LV_STATE_DEFAULT);
    lv_obj_set_style_text_font(ui->screen_music_label_music_time, &myFont_simkai16, LV_PART_MAIN | LV_STATE_DEFAULT);
    lv_obj_set_style_text_opa(ui->screen_music_label_music_time, 255, LV_PART_MAIN | LV_STATE_DEFAULT);
    lv_obj_set_style_text_letter_space(ui->screen_music_label_music_time, 0, LV_PART_MAIN | LV_STATE_DEFAULT);
    lv_obj_set_style_text_line_space(ui->screen_music_label_music_time, 0, LV_PART_MAIN | LV_STATE_DEFAULT);
    lv_obj_set_style_text_align(ui->screen_music_label_music_time, LV_TEXT_ALIGN_CENTER, LV_PART_MAIN | LV_STATE_DEFAULT);
    lv_obj_set_style_bg_opa(ui->screen_music_label_music_time, 0, LV_PART_MAIN | LV_STATE_DEFAULT);
    lv_obj_set_style_pad_top(ui->screen_music_label_music_time, 0, LV_PART_MAIN | LV_STATE_DEFAULT);
    lv_obj_set_style_pad_right(ui->screen_music_label_music_time, 0, LV_PART_MAIN | LV_STATE_DEFAULT);
    lv_obj_set_style_pad_bottom(ui->screen_music_label_music_time, 0, LV_PART_MAIN | LV_STATE_DEFAULT);
    lv_obj_set_style_pad_left(ui->screen_music_label_music_time, 0, LV_PART_MAIN | LV_STATE_DEFAULT);
    lv_obj_set_style_shadow_width(ui->screen_music_label_music_time, 0, LV_PART_MAIN | LV_STATE_DEFAULT);

