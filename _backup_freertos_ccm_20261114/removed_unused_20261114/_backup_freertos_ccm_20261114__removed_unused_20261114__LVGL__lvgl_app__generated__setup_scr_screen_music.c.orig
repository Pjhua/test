    lv_obj_set_style_bg_opa(ui->screen_music_ddlist_song, 255, LV_PART_MAIN | LV_STATE_DEFAULT);
    lv_obj_set_style_bg_color(ui->screen_music_ddlist_song, lv_color_hex(0xffffff), LV_PART_MAIN | LV_STATE_DEFAULT);
