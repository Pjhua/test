    lv_obj_set_style_pad_left(ui->screen_music_ddlist_song, 6, LV_PART_MAIN | LV_STATE_DEFAULT);
    lv_obj_set_style_pad_right(ui->screen_music_ddlist_song, 6, LV_PART_MAIN | LV_STATE_DEFAULT);
