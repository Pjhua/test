    ui->screen_music_ddlist_song = lv_dropdown_create(ui->screen_music);
    lv_obj_set_pos(ui->screen_music_ddlist_song, 5, 0);
    lv_obj_set_size(ui->screen_music_ddlist_song, 230, 34);
    lv_dropdown_set_options(ui->screen_music_ddlist_song, "无歌曲");
