       缺字方块；改成 ASCII 的 v，由 myFont_simkai16 正常渲染。 */
    lv_dropdown_set_symbol(ui->screen_music_ddlist_song, "v");
    lv_obj_set_style_text_font(ui->screen_music_ddlist_song, &myFont_simkai16, LV_PART_INDICATOR | LV_STATE_DEFAULT);

    // Write style for screen_music_ddlist_song, Part: LV_PART_MAIN, State: LV_STATE_DEFAULT.
