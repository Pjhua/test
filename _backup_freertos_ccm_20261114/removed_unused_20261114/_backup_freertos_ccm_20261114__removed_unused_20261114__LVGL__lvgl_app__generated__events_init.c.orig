/* screen_sms 数据刷新定时器回调
   每 500ms 读一次传感器 + 设备状态，更新所有 bar / label / LED 控件 */
static void screen_look_refresh_timer_cb(lv_timer_t *timer)
{
    lv_ui *ui = (lv_ui *)lv_timer_get_user_data(timer);
    Sht3x_TypeDef sht3;
    float pitch_f, roll_f, yaw_f;
    uint16_t adc_light;
    uint32_t light_mv;
    uint8_t light_pct;
    int servo_deg;
    int fan_pct;

    /* ---- 温湿度：SHT30，共用 MPU6050 的 PB6/PB7 软件IIC ----
       只显示整数，绕开 lv_sprintf_builtin.c 的 %f 兼容性问题 */
    if (Sht3x_Read_TemperatureHumidity(&sht3) == 0)
    {
        int t = (int)(sht3.temperature + (sht3.temperature >= 0 ? 0.5 : -0.5));
        int h = (int)((double)sht3.humidity + (sht3.humidity >= 0 ? 0.5 : -0.5));
        if (t < 0) t = 0;
        if (t > 50) t = 50;
        lv_bar_set_value(ui->screen_look_bar_temp, t * 100 / 50, LV_ANIM_ON);
        lv_label_set_text_fmt(ui->screen_look_label_temp_vol, "%d度", t);


        if (h < 0) h = 0;
        if (h > 100) h = 100;
        lv_bar_set_value(ui->screen_look_bar_hum, h, LV_ANIM_ON);
        lv_label_set_text_fmt(ui->screen_look_label_hum_vol, "%d%%", h);
    }
    /* ---- 光照：光敏 ADC3_Ch10 + 分压计算 ---- */
    adc_light = ADC_Filter(10, LIGHT_CH_IDX);
    light_mv  = (uint32_t)adc_light * 3300 / 4096;
    light_pct = Get_LightIntensity(light_mv);
    lv_bar_set_value(ui->screen_look_bar_lig, light_pct, LV_ANIM_ON);
    lv_label_set_text_fmt(ui->screen_look_label_lig_vol, "%d%%", light_pct);

    /* ---- 风扇：读设备状态 ---- */
    fan_pct = ctrl_state.fan;
    lv_bar_set_value(ui->screen_look_bar_gear, fan_pct, LV_ANIM_ON);
    lv_label_set_text_fmt(ui->screen_look_label_gear_vol, "%d档", ctrl_state.fan);

    /* ---- 舵机：读设备状态 ---- */
    servo_deg = ctrl_state.sg90 * 45;
    lv_bar_set_value(ui->screen_look_bar_angle, servo_deg, LV_ANIM_ON);
    lv_label_set_text_fmt(ui->screen_look_label_angle_vol, "%d度", servo_deg);

    /* ---- 陀螺仪：用 MPU6050 硬件 DMP 姿态解算 ----
       mpu_dmp_get_data 内部融合了加速度计 + 陀螺仪 6 轴数据，
       输出的 pitch/roll/yaw 是已经融合好的角度（不需要软件 atan2）。
       ⚠ 注意：MPU6050 没有磁力计，yaw 只能靠陀螺仪积分，长期会飘，
         但屏幕显示够用；pitch/roll 因为有加速度计做参考，比较准。 */
    u8 g = mpu_dmp_get_data(&pitch_f, &roll_f, &yaw_f);
static int dbg = 0;
if (++dbg <= 20) printf("get=%d p=%.1f\r\n", g, pitch_f);
if (g == 0) 
    {
        int p10, r10, y10;
        int pi, pd, ri, rd, yi, yd;
        p10 = (int)(pitch_f * 10.0f + (pitch_f >= 0 ? 0.5f : -0.5f));
        r10 = (int)(roll_f  * 10.0f + (roll_f  >= 0 ? 0.5f : -0.5f));
        y10 = (int)(yaw_f   * 10.0f + (yaw_f   >= 0 ? 0.5f : -0.5f));
        pi = p10 / 10;
        pd = (p10 < 0 ? -p10 : p10) % 10;
        ri = r10 / 10;
        rd = (r10 < 0 ? -r10 : r10) % 10;
        yi = y10 / 10;
        yd = (y10 < 0 ? -y10 : y10) % 10;
        if (p10 < 0) {
            lv_label_set_text_fmt(ui->screen_look_label_mpu_x, "-%d.%d", -pi, pd);
        }
        else         {
            lv_label_set_text_fmt(ui->screen_look_label_mpu_x,  "%d.%d",  pi, pd);
        }
        if (r10 < 0) {
            lv_label_set_text_fmt(ui->screen_look_label_mpu_y,  "-%d.%d", -ri, rd);
        }
        else         {
            lv_label_set_text_fmt(ui->screen_look_label_mpu_y,   "%d.%d",  ri, rd);
        }
        if (y10 < 0) {
            lv_label_set_text_fmt(ui->screen_look_label_mpu_z,   "-%d.%d", -yi, yd);
        }
        else         {
            lv_label_set_text_fmt(ui->screen_look_label_mpu_z,    "%d.%d",  yi, yd);
        }
    }
}

static void screen_look_event_handler(lv_event_t *e)
{
    lv_event_code_t code = lv_event_get_code(e);
    lv_ui *ui = (lv_ui *)lv_event_get_user_data(e);
    switch (code)
    {
    case LV_EVENT_GESTURE:
    {
        lv_dir_t dir = lv_indev_get_gesture_dir(lv_indev_active());
        switch (dir)
        {
        case LV_DIR_TOP:
        {
            lv_indev_wait_release(lv_indev_active());
            ui_load_scr_animation(&guider_ui, &guider_ui.screen_main_1, guider_ui.screen_main_1_del, &guider_ui.screen_look_del, setup_scr_screen_main_1, LV_SCR_LOAD_ANIM_NONE, 200, 200, true, true);
            if (s_app_timer)
            {
                lv_timer_del(s_app_timer);
                s_app_timer=NULL;
            }
            break;
        }
        default:
            break;
        }
        break;
    }
    case LV_EVENT_SCREEN_LOADED:
    {
        if (!s_app_timer)
            s_app_timer=lv_timer_create(screen_look_refresh_timer_cb, 500, ui);
        break;
    }
    case LV_EVENT_SCREEN_UNLOADED:
    {
        if (s_app_timer)
        {
            lv_timer_del(s_app_timer);
            s_app_timer=NULL;
        }
        break;
    }
    default:
        break;
    }
}

void events_init_screen_look(lv_ui *ui)
{
    lv_obj_add_event_cb(ui->screen_look, screen_look_event_handler, LV_EVENT_ALL, ui);
}

