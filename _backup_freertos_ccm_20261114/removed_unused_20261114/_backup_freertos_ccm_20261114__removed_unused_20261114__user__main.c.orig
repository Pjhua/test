/*=======================================================================================================*/
void is_loadfont(void)
{
    u8 flag = 0;
    u8 magic = 0xA5; // 烧录标志内容
    W25qxx_ReadDatas(&flag, RES_FLAG_ADDR, 1);
    if (key_scan() || flag != magic) //
    {

#if 0 // 串口助手烧录字库
        printf("\r\n检测到字库和图片未烧录,请通过串口1发送 allResource.bin 进行烧录！\r\n");
        W25qxx_Usart1_DownloadFile(0, 570); // 字库+图片--烧录 allResource.bin（2334184字节，需570个扇区）
#else // 文件系统烧录字库
        W25qxx_fatfs_DownloadFile(0, 570, "0:/font/allResource.bin");
#endif
        // 烧录完成，擦除标志扇区并写入烧录标志
        W25qxx_EraseSector(RES_FLAG_SECTOR);
        W25qxx_WritePage(&magic, RES_FLAG_ADDR, 1);
        // 读回检查标志是否写入成功
        flag = 0;
        W25qxx_ReadDatas(&flag, RES_FLAG_ADDR, 1);
        if (flag == magic)
        {
            printf("烧录标志写入成功，下次上电将直接进入主界面。\r\n");
        }
        else
        {
            printf("警告：烧录标志写入失败！\r\n");
        }
    }
    else
    {
        printf("字库和图片已烧录，直接进入主界面。\r\n");
    }
}

/*=======================================================================================================*/

void fatfs_test(void)
{
    u8 ret;
    FATFS fs;
    FIL fp;
    UINT br, bw;
    u8 buff[32];
    u8 str[] = "hello 12345678";

    ret = f_mount(&fs, "0:", 1);
    if (ret == FR_OK)
    {
        printf("挂载成功\r\n");
    }
    else
    {
        printf("挂载失败\r\n");
        return;
    }
    ret = f_open(&fp, "202610191706.txt", FA_CREATE_ALWAYS | FA_WRITE | FA_READ);
    if (ret == FR_OK)
    {
        printf("打开文件成功\r\n");
    }
    else
    {
        printf("打开文件失败\r\n");
        return;
    }
    f_write(&fp, str, sizeof(str), &bw);
    if (ret == FR_OK)
    {
        printf("写入文件成功,写入了%d字节\r\n", bw);
    }
    else
    {
        printf("写入文件失败\r\n");
        return;
    }
    f_close(&fp);
    // 重新打开文件读取内容
    ret = f_open(&fp, "202610191706.txt", FA_READ);
    if (ret == FR_OK)
    {
        printf("重新打开文件成功\r\n");
    }
    else
    {
        printf("重新打开文件失败\r\n");
        return;
    }
    ret = f_read(&fp, buff, sizeof(buff), &br);
    if (ret == FR_OK && br != 0)
    {
        printf("读取文件成功,内容为:%s,字节数:%d\r\n", buff, br);
    }
    else
    {
        printf("读取文件失败\r\n");
        return;
    }
    f_close(&fp);
}
