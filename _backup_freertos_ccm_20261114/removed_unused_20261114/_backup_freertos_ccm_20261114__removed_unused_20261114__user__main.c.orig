#define RES_FLAG_SECTOR 570        // 烧录标志存放的扇区（资源区占用0~601，紧跟其后）
#define RES_FLAG_ADDR (570 * 4096) // 烧录标志的字节地址

lv_ui guider_ui;

int main()
{
    u8 ret = 1;
    volatile u32 uwADCxConvertedVoltage = 0;
    NVIC_PriorityGroupConfig(NVIC_PriorityGroup_2); // NVIC分组
    led_init();
    key_init();
    beep_init();
    relay_init();
    fan_init();
    delay_init(168);
    usart1_init(115200);
    usart2_init(115200);
    usart3_init(115200);
    EXTI_Config();
    timer6_init(2, 42);
    timer7_init(10000, 8400);
    timer2_init(2000, 8400);
    W25qxx_Init();
    // is_loadfont();
    if (key_scan())
    {
        W25qxx_fatfs_DownloadFile(0, 239, "0:/font/myFont_simkai16.bin");
    }
    ret = mpu_dmp_init();
    if (ret != 0)
    {
        printf("mpu6050初始化失败\r\n");
    }
    rtc_init();
    sg90_init();
    fan_pwm_init();
    // led_pwm_init();
    // bl_pwm_init();
    // key_capture_init();
    sr04_init();
    w2812_init();
    // RgbDma_Init();
    my_mem_init(SRAMIN); // 内存管理
    my_mem_init(SRAMCCM);

    ret = SD_Initialize();
    if (ret == 0)
    {
        printf("SD卡初始化成功\r\n");
    }
    else
    {
        printf("SD卡初始化失败\r\n");
    }
    FATFS fs;
    FRESULT res;
    // 1.挂载
    res = f_mount(&fs, "0", 0);
    if (res == FR_OK)
    {
        printf("挂载成功\r\n");
    }
    else
    {
        printf("挂载失败\r\n");
    }

    
    /*lvgl*/
    lv_init();
    timer1_lvgl_init();   // lvgl心跳
    lv_port_disp_init();  // lvgl显示
    lv_port_indev_init(); // lvgl输入
	lv_fs_fatfs_init();
	
    lv_example_image_1();
//     setup_ui(&guider_ui);
//     custom_init(&guider_ui);

    while (1)
    {
        lv_task_handler();
        delay_ms(10);
    }

#if 0
    /* 旧版未使用代码（已停用，留存备查）：
     * 1) Wm8978 音频初始化 + WM8978_SPKvol_Set：LVGL 音乐屏接入播放功能时再启用；
     * 2) FATFS 挂载：相册/电子书等文件功能使用；
     * 3) gui_init()：旧桌面系统入口（app/app_gui.c + app.c），当前界面由 GUI Guider 生成。
     * 启用方法：删除上方 #if 0 与下方 #endif 两行即可恢复原代码。 */
    Wm8978_Init();
    Wav_I2sDmaTx_Callback();
    WM8978_SPKvol_Set(32);

    // ebook_demo();


    gui_init();

    ADC_Config();
#if ADC_USE_DMA
    ADC_SoftwareStartConv(ADC3);
#endif
#endif /* #if 0 结束：以下 printf/死循环原为不可达代码，随旧初始化一并停用 */
    printf("hello\r\n");

    while (1)
    {
    }
}
